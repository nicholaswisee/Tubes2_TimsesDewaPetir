# Caddy listens on port 80.
# Traffic is routed:
#   /api/*  -> Gin backend  (backend:8080)
#   /*      -> Bun frontend (frontend:3000)

:80 {
    # Backend API — strip nothing, Gin handles the /api prefix
    reverse_proxy /api/* backend:8080

    # Frontend — everything else goes to the TanStack Start SSR server
    reverse_proxy * frontend:3000
}
